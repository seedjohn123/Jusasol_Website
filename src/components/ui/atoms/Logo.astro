---
import companyRaw from '@data/global/company.json';
import type { CompanyConfig } from '@/types/config';

const company = companyRaw as CompanyConfig;

interface Props {
	variant?: "light" | "dark" | "inherit";
	showText?: boolean;
	className?: string;
	/** `compact`, mniejsza ikona i typografia pod pasek nav */
	density?: "default" | "compact";
}

const { variant = "dark", showText = true, className = "", density = "default" } = Astro.props;

const tone = variant === "light" ? "text-brand-light" : variant === "dark" ? "text-brand-dark" : "text-current";
const markClass = density === "compact" ? "h-10 w-10 lg:h-12 lg:w-12" : "h-11 w-11";
const nameClass = density === "compact" ? "text-[1.05rem] lg:text-[1.2rem]" : "text-lg";
---

<div class={`flex items-center ${density === "compact" ? "gap-2.5" : "gap-3"} ${className}`}>
  <svg class={`${markClass} shrink-0`} viewBox="0 0 64 64" role="img" aria-label={`${company.name} ${company.branding.logoSuffix || "Logo"}`}>
    <rect width="64" height="64" rx="18" fill="#5C3A24" />
    <circle cx="32" cy="32" r="23" fill="none" stroke="#E7C98A" stroke-width="1.25" />
    <g stroke="#E7C98A" stroke-width="1.7" stroke-linecap="round">
      <path d="M32 6.5v5.5M32 52v5.5M6.5 32h5.5M52 32h5.5" />
      <path d="M13 13l4 4M47 47l4 4M51 13l-4 4M17 47l-4 4" />
    </g>
    <path fill="#F7F1E6" d="M22.5 43.5 31 16.5h6.2L29.8 31H44L27.2 49.5 33.4 33.2H22.8l-.3 10.3Z" />
  </svg>
  {
    showText && (
      <span class={`font-heading font-semibold leading-none ${tone}`}>
        <span class={`block tracking-[-0.045em] ${nameClass}`}>JUSASOL</span>
      </span>
    )
  }
</div>
